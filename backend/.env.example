# ===== Database =====
DATABASE_URL="postgresql://admin:secret123@localhost:5432/myappdb"

# ===== App =====
PORT=8000
NODE_ENV=development

# ===== JWT =====
JWT_SECRET=your-super-long-random-secret-min-64-chars-change-this-in-production
